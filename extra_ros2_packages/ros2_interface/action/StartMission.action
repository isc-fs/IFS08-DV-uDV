# Action: ros2_interface/StartMission
# Sent from the autonomy stack to the uDV to begin executing a mission.
# The uDV reports acceleration / steering commands as feedback and
# terminal completion status as the result.
#
# Schema reconstructed from firmware usage in Core/Src/ros_interface.cpp
# and atomic types declared in Core/Inc/ros_globals.h.

# Goal
int32 mission_id
---
# Result
bool finished
bool emergency
---
# Feedback
float32 acceleration
float32 steering
bool finished
bool emergency
