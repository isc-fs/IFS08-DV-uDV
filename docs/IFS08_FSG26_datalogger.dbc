BS_:

BU_: UDV RES DL


BO_ 1280 DV_driving_dynamics_1: 8 UDV
 SG_ Speed_actual : 0|8@1+ (1,0) [0|255] "m/s" DL
 SG_ Speed_target : 8|8@1+ (1,0) [0|255] "m/s" DL
 SG_ Steering_angle_actual : 16|8@1- (0.5,0) [-64|63.5] "deg" DL
 SG_ Steering_angle_target : 24|8@1- (0.5,0) [-64|63.5] "deg" DL
 SG_ Brake_hydr_actual : 32|8@1+ (1,0) [0|100] "%" DL
 SG_ Brake_hydr_target : 40|8@1+ (1,0) [0|100] "%" DL
 SG_ Motor_moment_actual : 48|8@1- (1,0) [-100|100] "%" DL
 SG_ Motor_moment_target : 56|8@1- (1,0) [-100|100] "%" DL

BO_ 1281 DV_driving_dynamics_2: 6 UDV
 SG_ Acceleration_longitudinal : 0|16@1- (0.001953125,0) [-64|63.998046875] "m/s^2" DL
 SG_ Acceleration_lateral : 16|16@1- (0.001953125,0) [-64|63.998046875] "m/s^2" DL
 SG_ Yaw_rate : 32|16@1- (0.0078125,0) [-256|255.9921875] "deg/s" DL

BO_ 1282 DV_system_status: 5 UDV
 SG_ AS_state : 0|3@1+ (1,0) [0|7] "" DL
 SG_ ASB_EBS_state : 3|2@1+ (1,0) [0|3] "" DL
 SG_ AMI_state : 5|3@1+ (1,0) [0|7] "" DL
 SG_ Steering_state : 8|1@1+ (1,0) [0|1] "" DL
 SG_ ASB_redundancy_state : 9|2@1+ (1,0) [0|3] "" DL
 SG_ Lap_counter : 11|4@1+ (1,0) [0|15] "" DL
 SG_ Cones_count_actual : 15|8@1+ (1,0) [0|255] "" DL
 SG_ Cones_count_all : 23|17@1+ (1,0) [0|131071] "" DL

BO_ 1297 DV_ASF_1_safety: 8 UDV
 SG_ ASF_EBS_pressure_front : 0|16@1+ (0.1,0) [0|25] "bar" DL
 SG_ ASF_EBS_pressure_rear : 16|16@1+ (0.1,0) [0|25] "bar" DL
 SG_ ASF_EBS_init_state : 32|4@1+ (1,0) [0|8] "" DL
 SG_ ASF_EBS_activated : 36|1@1+ (1,0) [0|1] "" DL
